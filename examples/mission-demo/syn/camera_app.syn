namespace camera_app

/// Camera operating mode.
enum u8 CameraMode {
    /// Camera is powered but idle.
    Standby = 0
    /// Camera is exposing frames.
    Imaging = 1
    /// Camera is in a conservative thermal mode.
    Safe = 2
}

/// Exposure configuration for the detector.
struct ExposureConfig {
    /// Exposure duration in microseconds.
    exposure_us: u32
    /// Analog gain in decibels.
    gain_db: f32
}

/// Camera health and frame counter.
telemetry CameraStatus {
    /// Current camera mode.
    mode: CameraMode
    /// Frames captured since boot.
    frames_captured: u32
    /// Detector temperature.
    detector_temp_c: f32
}

/// Commands routed to the camera application.
commands CameraCommands {
    /// Request a new camera mode.
    @cc(1)
    command SetCameraMode {
        /// Requested mode.
        mode: CameraMode
    }

    /// Request a new exposure configuration.
    @cc(2)
    command SetExposure {
        /// New exposure settings.
        config: ExposureConfig
    }

}
