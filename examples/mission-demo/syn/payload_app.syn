namespace payload_app

/// Payload acquisition state.
enum u8 PayloadState {
    /// Payload is idle.
    Idle = 0
    /// Payload is collecting science data.
    Collecting = 1
    /// Payload is paused for downlink or storage pressure.
    Paused = 2
}

/// Payload status packet.
telemetry PayloadStatus {
    /// Current payload state.
    state: PayloadState
    /// Science packets produced since boot.
    science_packets: u32
    /// Storage utilization percentage.
    storage_percent: u8
}

/// Commands routed to the payload application.
commands PayloadCommands {
    /// Start payload acquisition.
    @cc(1)
    command StartAcquisition {
        /// Acquisition duration in seconds.
        duration_s: u32
    }
}
