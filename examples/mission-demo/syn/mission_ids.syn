namespace demo_mission_ids

/// Navigation telemetry packet MID.
const NAV_STATE_TLM_MID: u16 = 0x0801

/// Navigation command packet MID.
const NAV_CMD_MID: u16 = 0x1801

/// Camera telemetry packet MID.
const CAMERA_STATUS_TLM_MID: u16 = 0x0881

/// Camera command packet MID shared by camera commands.
const CAMERA_CMD_MID: u16 = 0x1881

/// Payload telemetry packet MID.
const PAYLOAD_STATUS_TLM_MID: u16 = 0x0901

/// Payload command packet MID.
const PAYLOAD_CMD_MID: u16 = 0x1901

/// Command code for SetNavMode.
const NAV_SET_MODE_CC: u16 = 1

/// Command code for SetCameraMode.
const CAMERA_SET_MODE_CC: u16 = 1

/// Command code for SetExposure.
const CAMERA_SET_EXPOSURE_CC: u16 = 2

/// Command code for StartAcquisition.
const PAYLOAD_START_ACQUISITION_CC: u16 = 1

